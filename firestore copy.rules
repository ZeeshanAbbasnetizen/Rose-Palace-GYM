rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation helper for ContactSubmission
    function isValidContactSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'mobile', 'message', 'createdAt']) 
        && data.keys().size() == 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.mobile is string && data.mobile.size() > 0 && data.mobile.size() <= 20
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time;
    }

    match /contact_submissions/{submissionId} {
      allow create: if isValidContactSubmission(incoming());
      // No read/update/delete for public users
    }
  }
}
